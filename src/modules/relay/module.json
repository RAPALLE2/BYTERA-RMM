{
  "schema": 1,
  "id": "relay",
  "name": "Explorer-Relay",
  "version": "1.0.0",
  "description": "Gibt Dateien von Clients per Relay frei (FTP/SFTP/WebDAV) und zeigt dort die Spaces (Modul „Spaces“) und den Deployment-Ordner (Modul „Deployment-Server“).",
  "author": "BYTERA",
  "category": "Fernzugriff",
  "icon": "🔌",
  "requires": [],
  "pip": [
    "paramiko>=3.4"
  ],
  "routers": [
    "relay_routes",
    "storage_routes"
  ],
  "hooks": {
    "startup": "on_startup"
  },
  "entry": "module",
  "apps": [
    {
      "id": "relay-explorer",
      "label": "Relay-Explorer",
      "icon": "📦",
      "title": "Relay-Explorer",
      "entry": "relayexplorer.js",
      "export": "renderRelayExplorer",
      "w": 860,
      "h": 560
    },
    {
      "id": "relay-manager",
      "label": "Explorer-Relay",
      "icon": "🔌",
      "title": "Explorer-Relay verwalten",
      "entry": "relaymanager.js",
      "export": "renderRelayManager",
      "w": 760,
      "h": 560,
      "perm": "use_relay"
    }
  ],
  "settings_ui": {
    "entry": "settings.js",
    "export": "renderSettings"
  }
}
