{
  "schema": 1,
  "id": "sso",
  "name": "SSO / Directory Login",
  "version": "1.0.0",
  "description": "Login via LDAP / Active Directory (realms) incl. import of AD groups. Can only be disabled when at least one local, active admin account exists. After that, AD users remain but cannot sign in.",
  "author": "BYTERA",
  "category": "sicherheit",
  "icon": "🔐",
  "requires": [],
  "pip": [
    "ldap3>=2.9.0"
  ],
  "entry": "module",
  "routers": [
    "sso_routes"
  ],
  "hooks": {
    "before_disable": "can_disable",
    "disable": "on_disable"
  },
  "apps": [
    {
      "id": "sso-realms",
      "label": "SSO / Directory",
      "icon": "🔐",
      "title": "SSO / Directory Login",
      "entry": "settings.js",
      "export": "renderSsoApp",
      "w": 760,
      "h": 640,
      "perm": "manage_sso"
    }
  ],
  "settings_ui": {
    "entry": "settings.js",
    "export": "renderSsoSettings"
  }
}