{
  "schema": 1,
  "id": "notify",
  "name": "Notifications",
  "version": "1.0.0",
  "description": "Notification rules (triggers like client offline, CPU load, website down, login …) delivered via email (SMTP), webhook (Discord/Custom) or as a dashboard toast. When the module is off, no notifications are sent.",
  "author": "BYTERA",
  "category": "zusammenarbeit",
  "icon": "🔔",
  "requires": [],
  "pip": [],
  "entry": "module",
  "routers": [
    "notify_routes",
    "webhook_routes"
  ],
  "hooks": {
    "startup": "on_startup",
    "client_online": "on_event",
    "client_offline": "on_event",
    "client_new": "on_event",
    "agent_update": "on_event",
    "website_up": "on_event",
    "website_down": "on_event",
    "user_login": "on_event",
    "login_failed": "on_event"
  },
  "apps": [
    {
      "id": "notifications",
      "label": "Notifications",
      "icon": "🔔",
      "title": "Notifications",
      "entry": "notifications.js",
      "export": "renderNotifyApp",
      "w": 900,
      "h": 660,
      "perm": "manage_settings"
    }
  ],
  "settings_ui": {
    "entry": "notifications.js",
    "export": "renderNotifySettings"
  }
}